# ==============================================================================
# MK Silver Hub / MK Jeweller - Environment Configuration Example
# Production Domain: https://mksilverhub.com
# Target Deployment: Cloudflare Workers
# ==============================================================================

# MongoDB Atlas Production Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mk_silver_hub?retryWrites=true&w=majority
MONGODB_URI=

# Cryptographic Session & Auth Signing Key (Minimum 32 random characters)
AUTH_SECRET=
SESSION_SECRET=

# Public Production URL
NEXT_PUBLIC_SITE_URL=https://mksilverhub.com

# Node Environment
NODE_ENV=production

# Cloudflare Deployment Credentials (For CI/CD or Wrangler CLI deployment)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
